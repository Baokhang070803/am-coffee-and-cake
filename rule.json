          "status": { 
            ".write": "auth != null && (auth.uid === data.child('userId').val() || auth.uid === newData.child('userId').val() || auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
            ".validate": "newData.isString() && newData.val().matches(/^(pending|awaiting_payment|confirmed|shipped|delivered|cancelled|payment_failed)$/)" 
          },
          "paymentStatus": { 
            ".write": "auth != null && (auth.uid === data.child('userId').val() || auth.uid === newData.child('userId').val() || auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
            ".validate": "newData.isString() && newData.val().matches(/^(pending|paid|failed|not_required)$/)" 
          },
          "paymentDetails": { 
            ".write": "auth != null && (auth.uid === data.child('userId').val() || auth.uid === newData.child('userId').val() || auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')"
          },
          "confirmedAt": { 
            ".write": "auth != null && (auth.uid === data.child('userId').val() || auth.uid === newData.child('userId').val() || auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
            ".validate": "newData.isString()" 
          },
          "updatedAt": { 
            ".write": "auth != null && (auth.uid === data.child('userId').val() || auth.uid === newData.child('userId').val() || auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
            ".validate": "newData.isString()" 
          },
          "billingInfo": {
            ".validate": "newData.hasChildren(['address', 'email', 'fullName', 'phone'])",
            "address": { ".validate": "newData.isString()" },
            "email": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)" },
            "fullName": { ".validate": "newData.isString() && newData.val().length > 0" },
            "phone": { ".validate": "newData.isString()" }
          },
          "customerInfo": {
            ".validate": "newData.hasChildren(['address', 'email', 'fullName', 'name', 'phone'])",
            "address": { ".validate": "newData.isString()" },
            "email": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)" },
            "fullName": { ".validate": "newData.isString() && newData.val().length > 0" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0" },
            "phone": { ".validate": "newData.isString()" }
          },
          "createdAt": { ".validate": "newData.isString()" },
          "deliveryMethod": { ".validate": "newData.isString()" },
          "discountAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "grandTotal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "items": {
            "$itemId": {
              ".validate": "newData.hasChildren(['productId', 'quantity'])",
              "productId": { ".validate": "newData.isString()" },
              "quantity": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "name": { ".validate": "newData.isString() && newData.val().length > 0" },
              "price": { ".validate": "newData.isNumber() && newData.val() >= 0" }
            }
          },
          "orderNote": { ".validate": "newData.isString()" },
          "paymentMethod": { ".validate": "newData.isString()" },
          "shippingFee": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "shippingInfo": {
            ".validate": "newData.hasChildren(['address', 'receiverName', 'receiverPhone'])",
            "address": { ".validate": "newData.isString()" },
            "receiverName": { ".validate": "newData.isString() && newData.val().length > 0" },
            "receiverPhone": { ".validate": "newData.isString()" }
          },
          "subtotal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "userId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "couponCode": { ".validate": "newData.isString()" },
          "discountedTotal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "date": { ".validate": "newData.isString()" },
          "time": { ".validate": "newData.isString()" },
          "fullName": { ".validate": "newData.isString() && newData.val().length > 0" }
        }
      },
      "vnpay_transactions": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$txnRef": {
          ".validate": "newData.hasChildren(['orderKey', 'amount', 'createdAt', 'status'])",
          "orderKey": { ".validate": "newData.isString() && newData.val().length > 0" },
          "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "createdAt": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(pending|completed|failed)$/)" }
        }
      },
      "payment_results": {
        ".read": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
        ".write": "auth != null",
        "$resultId": {
          ".validate": "newData.hasChildren(['transactionId', 'resultType', 'timestamps'])",
          "transactionId": { ".validate": "newData.isString() && newData.val().length > 0" },
          "txnRef": { ".validate": "newData.isString()" },
          "orderKey": { ".validate": "newData.isString() || newData.val() === null" },
          "resultType": { ".validate": "newData.isString() && newData.val().matches(/^(success|failed)$/)" },
          "vnpayData": { 
            ".validate": "newData.exists()",
            "amount": { ".validate": "newData.isString() || newData.val() === null" },
            "bankCode": { ".validate": "newData.isString() || newData.val() === null" },
            "responseCode": { ".validate": "newData.isString() || newData.val() === null" },
            "transactionNo": { ".validate": "newData.isString() || newData.val() === null" },
            "txnRef": { ".validate": "newData.isString() || newData.val() === null" },
            "payDate": { ".validate": "newData.isString() || newData.val() === null" }
          },
          "paymentInfo": {
            ".validate": "newData.exists()",
            "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "responseCode": { ".validate": "newData.isString() || newData.val() === null" },
            "responseMessage": { ".validate": "newData.isString() || newData.val() === null" }
          },
          "orderInfo": {
            "orderKey": { ".validate": "newData.isString() || newData.val() === null" },
            "customerName": { ".validate": "newData.isString() || newData.val() === null" },
            "totalAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          },
          "timestamps": { 
            ".validate": "newData.hasChildren(['createdAt'])",
            "createdAt": { ".validate": "newData.isString()" },
            "year": { ".validate": "newData.isNumber()" },
            "month": { ".validate": "newData.isNumber()" },
            "day": { ".validate": "newData.isNumber()" }
          }
        }
      },
      "payment_results_by_date": {
        ".read": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
        ".write": "auth != null",
        "$dateKey": {
          "$resultId": {
            ".validate": "newData.hasChildren(['transactionId', 'resultType', 'timestamps'])"
          }
        }
      },
      "payment_logs": {
        ".read": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
        ".write": "auth != null",
        "$logId": {
          ".validate": "newData.hasChildren(['transactionId', 'resultType', 'timestamps'])"
        }
      },
      "payment_statistics": {
        ".read": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
        ".write": "auth != null",
        "daily_simple": {
          "$dateKey": {
            "$statId": {
              ".validate": "newData.hasChildren(['date', 'transactionId', 'resultType', 'amount', 'timestamp'])",
              "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
              "transactionId": { ".validate": "newData.isString() && newData.val().length > 0" },
              "resultType": { ".validate": "newData.isString() && newData.val().matches(/^(success|failed)$/)" },
              "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "timestamp": { ".validate": "newData.isString()" },
              "needsSync": { ".validate": "newData.isBoolean() || newData.val() === null" }
            }
          }
        },
        "daily": {
          "$year": {
            "$month": {
              "$day": {
                ".validate": "newData.hasChildren(['totalTransactions', 'successfulTransactions', 'failedTransactions', 'totalAmount'])",
                "totalTransactions": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "successfulTransactions": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "failedTransactions": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "totalAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "lastUpdated": { ".validate": "newData.isString()" }
              }
            }
          }
        }
      },
      "payment_confirmations": {
        ".read": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
        ".write": "auth != null",
        "$confirmationId": {
          ".validate": "newData.hasChildren(['vnp_TxnRef', 'transactionNo', 'amount', 'responseCode', 'status', 'createdAt'])",
          "vnp_TxnRef": { ".validate": "newData.isString() && newData.val().length > 0" },
          "transactionNo": { ".validate": "newData.isString() && newData.val().length > 0" },
          "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "payDate": { ".validate": "newData.isString()" },
          "responseCode": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(pending_confirmation|confirmed|failed)$/)" },
          "createdAt": { ".validate": "newData.isString()" }
        }
      },
      "promotions": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
        "$promotionId": {
          ".validate": "newData.hasChildren(['code', 'discount', 'endDate', 'startDate', 'status'])",
          "code": { ".validate": "newData.isString() && newData.val().length > 0" },
          "discount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "endDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "startDate": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(active|inactive)$/)" }
        }
      },
      "contactMessages": {
        ".read": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
        ".write": true,
        "$msgId": {
          ".validate": "newData.hasChildren(['name', 'email', 'message', 'createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0" },
          "email": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)" },
          "phone": { ".validate": "newData.isString() || newData.val() === null" },
          "message": { ".validate": "newData.isString() && newData.val().length > 0" },
          "createdAt": { ".validate": "newData.isString()" }
        }
      },
      "chatMessages": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["senderId"],
        "$messageId": {
          ".validate": "newData.hasChildren(['sender', 'senderId', 'message', 'timestamp'])",
          "sender": { ".validate": "newData.isString() && newData.val().length > 0" },
          "senderId": { 
            ".validate": "newData.isString() && (newData.val() === 'anonymous' || newData.val() === auth.uid || auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')"
          },
          "message": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
          "timestamp": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]{3}Z$/)" }
        }
      },
      "news": {
        ".read": "true",
        ".write": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')"
      },
       "posts": {
        ".read": true,
        ".write": "auth != null"
      },
      "conversationMeta": {
        "$convId": {
          ".read": "auth != null && data.child('members').hasChild(auth.uid)",
          ".write": "auth != null && (data.child('members').hasChild(auth.uid) || newData.child('members').hasChild(auth.uid))"
        }
      },
      "userConversations": {
        "$userId": {
          ".read": "auth != null && auth.uid === $userId",
          ".write": "auth != null && auth.uid === $userId"
        }
      },
      "messages": {
        "$convId": {
          ".read": "auth != null && root.child('conversationMeta').child($convId).child('members').hasChild(auth.uid)",
          ".write": "auth != null && root.child('conversationMeta').child($convId).child('members').hasChild(auth.uid)"
        }
      }
    }
  }