{
    "rules": {
      "users": {
        "$userId": {
          ".read": true,
          ".write": "auth != null && (auth.uid === $userId || auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com')",
          ".validate": "newData.hasChildren(['name', 'email'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0" },
          "email": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)" },
          "phone": { ".validate": "newData.isString()" },
          "address": { ".validate": "newData.isString()" },
          "role": { ".validate": "newData.isString()" },
          "created_at": { ".validate": "newData.isString()" },
          "emailVerified": { ".validate": "newData.isBoolean()" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "friends": {
            "$otherId": {
              ".read": "auth != null && (auth.uid === $userId || auth.uid === $otherId)",
              ".write": "auth != null && (auth.uid === $userId || auth.uid === $otherId)"
            }
          },
          "friendRequests": {
            "$fromId": {
              ".read": "auth != null && (auth.uid === $userId || auth.uid === $fromId)",
              ".write": "auth != null && (auth.uid === $userId || auth.uid === $fromId)"
