          "userId": { ".validate": "newData.isString() && newData.val() === auth.uid" }
        }
      },
      "orders": {
        ".read": "auth != null && (auth.token.email === 'quantri1amcoffeeandcake@gmail.com' || auth.token.email === 'nhanvienorders@gmail.com' || query.orderByChild == 'userId' && query.equalTo == auth.uid)",
        ".write": "auth != null",
